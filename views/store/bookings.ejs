<%- include('../partials/head') %>
  </head>
  <body class="app-body">
    <%- include('../partials/nav') %>
    <main class="page-shell">
      <section class="section-heading page-heading"><div><span class="eyebrow">Your trips</span><h1>My bookings</h1><p>Everything you've reserved, in one place.</p></div><span class="result-count"><%= bookings ? bookings.length : 0 %> bookings</span></section>
      <% if (!bookings || bookings.length === 0) { %>
        <div class="empty-state"><div class="empty-icon"><i class="fa-regular fa-calendar-check"></i></div><h2>No bookings yet</h2><p>Ready for your next escape? Find a home and make your first reservation.</p><a href="/homes" class="btn btn-primary">Find a home</a></div>
      <% } else { %>
        <section class="booking-grid">
          <% bookings.forEach(booking => { %>
            <% if (booking.home) { %>
              <article class="booking-card">
                <img src="<%= booking.home.photo %>" alt="<%= booking.home.houseName %>">
                <div class="booking-body">
                  <div class="booking-top"><span class="status-pill confirmed"><i class="fa-solid fa-circle-check"></i> <%= booking.status %></span><span class="booking-date">Booked <%= new Date(booking.bookingDate).toLocaleDateString() %></span></div>
                  <h2><%= booking.home.houseName %></h2>
                  <p class="location"><i class="fa-solid fa-location-dot"></i> <%= booking.home.location %></p>
                  <div class="booking-meta"><strong>₹<%= booking.home.price %></strong><span>/ night</span><span>•</span><span><i class="fa-solid fa-star"></i> <%= booking.home.rating %></span></div>
                  <form action="/bookings/cancel/<%= booking._id %>" method="POST"><button type="submit" class="btn btn-danger-soft"><i class="fa-regular fa-calendar-xmark"></i> Cancel booking</button></form>
                </div>
              </article>
            <% } %>
          <% }) %>
        </section>
      <% } %>
    </main>
  </body>
</html>