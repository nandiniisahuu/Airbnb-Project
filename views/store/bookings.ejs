<%- include('../partials/head') %>
</head>

<body>
  <%- include('../partials/nav') %>

  <main class="container mx-auto mt-10 max-w-6xl px-4">

    <h2 class="text-4xl font-bold text-red-500 text-center mb-10">
      My Bookings
    </h2>

    <% if (!bookings || bookings.length === 0) { %>

      <div class="text-center">
        <p class="text-2xl text-gray-600">
          You have no bookings.
        </p>
      </div>

    <% } else { %>

      <div class="flex flex-wrap justify-center gap-6">

        <% bookings.forEach(booking => { %>

          <% if (booking.home) { %>

            <div class="bg-white rounded-lg shadow-md overflow-hidden w-full max-w-sm">

              <img
                src="<%= booking.home.photo %>"
                alt="<%= booking.home.houseName %>"
                class="w-full h-52 object-cover"
              >

              <div class="p-5">

                <h3 class="text-2xl font-bold text-gray-800 mb-3">
                  <%= booking.home.houseName %>
                </h3>

                <p class="text-gray-600 mb-2">
                  📍 <%= booking.home.location %>
                </p>

                <p class="text-red-500 font-bold text-lg mb-2">
                  ₹<%= booking.home.price %> / night
                </p>

                <p class="text-gray-700 mb-2">
                  ⭐ <%= booking.home.rating %> / 5
                </p>

                <p class="text-green-600 font-semibold mb-4">
                  Status: <%= booking.status %>
                </p>

                <p class="text-gray-500 text-sm mb-4">
                  Booked on:
                  <%= new Date(booking.bookingDate).toLocaleDateString() %>
                </p>

                <form
                  action="/bookings/cancel/<%= booking._id %>"
                  method="POST"
                >
                  <button
                    type="submit"
                    class="bg-red-400 hover:bg-red-600 text-white px-4 py-2 rounded transition"
                  >
                    Cancel Booking
                  </button>
                </form>

              </div>

            </div>

          <% } %>

        <% }) %>

      </div>

    <% } %>

  </main>

</body>
</html>