<%- include('../partials/head') %>
  </head>
  <body class="app-body">
    <%- include('../partials/nav') %>
    <main class="page-shell">
      <div class="detail-card">
        <div class="detail-image">
          <img src="<%= home.photo %>" alt="<%= home.houseName %>">
          <span class="image-badge"><i class="fa-solid fa-star"></i> <%= home.rating %></span>
        </div>
        <div class="detail-content">
          <span class="eyebrow">Private stay</span>
          <h1><%= home.houseName %></h1>
          <p class="location detail-location"><i class="fa-solid fa-location-dot"></i> <%= home.location %></p>
          <div class="detail-price">₹<%= home.price %> <span>/ night</span></div>
          <div class="detail-divider"></div>
          <h3>About this place</h3>
          <p class="detail-description"><%= home.description %></p>
          <div class="detail-features">
            <div><i class="fa-solid fa-star"></i><span><strong><%= home.rating %></strong> rating</span></div>
            <div><i class="fa-solid fa-shield-heart"></i><span>Comfortable stay</span></div>
            <div><i class="fa-solid fa-location-dot"></i><span>Great location</span></div>
          </div>
          <div class="detail-actions">
            <% if (isLoggedIn && user && user.userType === 'guest') { %>
              <%- include('../partials/favourite', {home: home}) %>
              <form action="/book/<%= home._id %>" method="POST" class="inline-form">
                <button type="submit" class="btn btn-primary btn-lg"><i class="fa-regular fa-calendar-check"></i> Reserve home</button>
              </form>
            <% } %>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>