<%- include('../partials/head') %>
  </head>
  <body class="app-body">
    <%- include('../partials/nav') %>
    <main class="page-shell">
      <section class="section-heading page-heading"><div><span class="eyebrow">Your collection</span><h1>Saved favourites</h1><p>Places you don't want to forget.</p></div></section>
      <% if (!favouriteHomes || favouriteHomes.length === 0) { %>
        <div class="empty-state"><div class="empty-icon"><i class="fa-regular fa-heart"></i></div><h2>No favourites yet</h2><p>Save a home while exploring and it will appear here.</p><a href="/homes" class="btn btn-primary">Explore homes</a></div>
      <% } else { %>
        <section class="home-grid">
          <% favouriteHomes.forEach(home => { %>
            <article class="home-card">
              <div class="card-image-wrap"><img src="<%= home.photo %>" alt="<%= home.houseName %>"><span class="image-badge"><i class="fa-solid fa-heart"></i></span></div>
              <div class="home-card-body">
                <div class="card-title-row"><h3><%= home.houseName %></h3><span class="price">₹<%= home.price %><small> / night</small></span></div>
                <p class="location"><i class="fa-solid fa-location-dot"></i> <%= home.location %></p>
                <div class="card-footer"><a href="/homes/<%= home._id %>" class="btn btn-dark">View home</a><form action="/favourites/delete/<%= home._id %>" method="POST" class="inline-form"><button class="btn btn-danger-soft" type="submit"><i class="fa-regular fa-trash-can"></i> Remove</button></form></div>
              </div>
            </article>
          <% }) %>
        </section>
      <% } %>
    </main>
  </body>
</html>