<%- include('../partials/head') %>
  </head>
  <body class="app-body">
    <%- include('../partials/nav') %>

    <main>
      <section class="hero-section">
        <div class="hero-copy">
          <span class="eyebrow"><i class="fa-solid fa-sparkles"></i> AI-powered stays</span>
          <h1>Find a place you'll <em>love</em> to stay.</h1>
          <p>Discover beautiful homes, compare stays and let AI match you with the right place in seconds.</p>
          <div class="hero-actions">
            <a href="/homes" class="btn btn-primary btn-lg"><i class="fa-solid fa-compass"></i> Explore homes</a>
            <a href="#ai-finder" class="btn btn-white btn-lg">Try AI Finder <i class="fa-solid fa-arrow-down"></i></a>
          </div>
        </div>
        <div class="hero-visual">
          <div class="hero-orb orb-one"></div>
          <div class="hero-orb orb-two"></div>
          <div class="hero-card">
            <div class="hero-card-icon"><i class="fa-solid fa-house"></i></div>
            <div><strong>Handpicked stays</strong><span>Made for your next escape</span></div>
            <i class="fa-solid fa-arrow-right hero-arrow"></i>
          </div>
        </div>
      </section>

      <section id="ai-finder" class="ai-panel">
        <div class="ai-heading">
          <div class="ai-badge"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
          <div>
            <span class="eyebrow">Smart search</span>
            <h2>Ask AI to find your perfect home</h2>
            <p>Describe your budget, location or vibe in natural language.</p>
          </div>
        </div>

        <form id="aiSearchForm" class="ai-search-form">
          <div class="search-input-wrap">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="aiQuery" placeholder="e.g. Manali me ₹5000 ke andar 4+ rating wala home" required>
          </div>
          <button type="submit" id="aiSearchButton" class="btn btn-primary btn-lg"><i class="fa-solid fa-wand-magic-sparkles"></i> Find my home</button>
        </form>

        <div id="aiLoading" class="ai-loading hidden">
          <span class="loader"></span> AI is finding the best matches for you...
        </div>
        <div id="aiRecommendation" class="ai-recommendation hidden"></div>
        <div id="aiResults" class="home-grid ai-results hidden"></div>
      </section>

      <section class="section-heading">
        <div>
          <span class="eyebrow">Explore stays</span>
          <h2>Homes people are loving</h2>
        </div>
        <a href="/homes" class="text-link">View all <i class="fa-solid fa-arrow-right"></i></a>
      </section>

      <section class="home-grid">
        <% registeredHomes.forEach(home => { %>
          <article class="home-card">
            <div class="card-image-wrap">
              <img src="<%= home.photo && home.photo.trim() ? '/' + home.photo : '/images/house5.png' %>" alt="<%= home.houseName || 'Home' %>">
              <span class="image-badge"><i class="fa-solid fa-star"></i> <%= home.rating %></span>
            </div>
            <div class="home-card-body">
              <div class="card-title-row">
                <h3><%= home.houseName %></h3>
                <span class="price">₹<%= home.price %><small> / night</small></span>
              </div>
              <p class="location"><i class="fa-solid fa-location-dot"></i> <%= home.location %></p>
              <div class="card-footer">
                <a href="/homes/<%= home._id %>" class="btn btn-dark">View home</a>
                <% if (isLoggedIn && user && user.userType === 'guest') { %>
                  <% if (bookedHomeIds && bookedHomeIds.includes(home._id.toString())) { %>
                    <span class="status-pill booked"><i class="fa-solid fa-check"></i> Booked</span>
                  <% } else { %>
                    <form action="/book/<%= home._id %>" method="POST" class="inline-form">
                      <button type="submit" class="btn btn-outline-success"><i class="fa-regular fa-calendar-check"></i> Book</button>
                    </form>
                  <% } %>
                <% } %>
              </div>
            </div>
          </article>
        <% }) %>
      </section>
    </main>

    <script>
  const aiSearchForm = document.getElementById("aiSearchForm");
  const aiQuery = document.getElementById("aiQuery");
  const aiSearchButton = document.getElementById("aiSearchButton");
  const aiLoading = document.getElementById("aiLoading");
  const aiRecommendation = document.getElementById("aiRecommendation");
  const aiResults = document.getElementById("aiResults");

  aiSearchForm.addEventListener("submit", async (event) => {
    event.preventDefault();

    const query = aiQuery.value.trim();

    if (!query) {
      return;
    }

    aiSearchButton.disabled = true;
    aiSearchButton.textContent = "Finding...";
    aiLoading.classList.remove("hidden");
    aiRecommendation.classList.add("hidden");
    aiResults.classList.add("hidden");

    try {
      const response = await fetch("/api/ai/recommend", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          query: query
        })
      });

      const data = await response.json();

      if (!response.ok || !data.success) {
        throw new Error(data.message || "Something went wrong");
      }

      aiLoading.classList.add("hidden");

      // AI recommendation
      aiRecommendation.innerHTML = `
        <h4 class="text-xl font-bold text-gray-800 mb-3">
          🤖 AI Recommendation
        </h4>

        <p class="text-gray-700 whitespace-pre-line">
          ${data.recommendation}
        </p>
      `;

      aiRecommendation.classList.remove("hidden");

      // Home results
      if (data.homes && data.homes.length > 0) {

        aiResults.innerHTML = data.homes.map(home => `
          <div class="home-card">

            <img
              src="${home.photo ? '/' + home.photo : '/images/house5.png'}"
              alt="${home.houseName}"
              class="ai-home-image"
            >

            <div class="p-4">

              <h4 class="text-lg font-bold text-gray-800 mb-2">
                ${home.houseName}
              </h4>

              <p class="text-gray-600 mb-2">
                📍 ${home.location}
              </p>

              <div class="flex justify-between items-center mb-4">

                <span class="font-bold text-red-500">
                  ₹${home.price} / night
                </span>

                <span class="text-gray-700">
                  ⭐ ${home.rating}
                </span>

              </div>

              <a
                href="/homes/${home._id}"
                class="inline-block bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg transition duration-300"
              >
                View Home
              </a>

            </div>
          </div>
        `).join("");

        aiResults.classList.remove("hidden");

      } else {

        aiResults.innerHTML = `
          <p class="text-gray-500 col-span-full text-center">
            No matching homes found.
          </p>
        `;

        aiResults.classList.remove("hidden");
      }

    } catch (error) {

      console.error("AI Search Error:", error);

      aiLoading.classList.add("hidden");

      aiRecommendation.innerHTML = `
        <p class="text-red-500">
          ${error.message || "Unable to get AI recommendations."}
        </p>
      `;

      aiRecommendation.classList.remove("hidden");

    } finally {

      aiSearchButton.disabled = false;
      aiSearchButton.textContent = "Find My Home";

    }
  });
</script>
  </body>
</html>