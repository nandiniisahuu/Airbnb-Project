<%- include('../partials/head') %>
  </head>
  <body class="app-body">
    <%- include('../partials/nav') %>
    <main class="page-shell">
      <section class="section-heading page-heading">
        <div><span class="eyebrow">Discover</span><h1>Find your next stay</h1><p>Comfortable homes in places worth exploring.</p></div>
        <span class="result-count"><%= registeredHomes.length %> stays</span>
      </section>
      <section class="home-grid">
        <% registeredHomes.forEach(home => { %>
          <article class="home-card">
            <div class="card-image-wrap">
              <img src="<%= home.photo %>" alt="<%= home.houseName %>">
              <span class="image-badge"><i class="fa-solid fa-star"></i> <%= home.rating %></span>
            </div>
            <div class="home-card-body">
              <div class="card-title-row"><h3><%= home.houseName %></h3><span class="price">₹<%= home.price %><small> / night</small></span></div>
              <p class="location"><i class="fa-solid fa-location-dot"></i> <%= home.location %></p>
              <div class="card-footer">
                <a href="/homes/<%= home._id %>" class="btn btn-dark">View details</a>
                <% if (isLoggedIn && user && user.userType === 'guest') { %><%- include('../partials/favourite', {home: home}) %><% } %>
              </div>
            </div>
          </article>
        <% }) %>
      </section>
    </main>
  </body>
</html>