<% if (errors && errors.length > 0) { %>
  <div class="alert alert-error" role="alert">
    <i class="fa-solid fa-circle-exclamation"></i>
    <div>
      <strong>Please check the following:</strong>
      <ul>
        <% errors.forEach(error => { %><li><%= error %></li><% }) %>
      </ul>
    </div>
  </div>
<% } %>