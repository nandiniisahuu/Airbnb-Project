<header class="site-header">
  <nav class="site-nav">

    <a href="/" class="brand">
      <span class="brand-mark">
        <i class="fa-solid fa-house"></i>
      </span>
      <span>StayNest</span>
    </a>

    <div class="desktop-nav">

      <% if (isLoggedIn) { %>

        <% if (user && user.userType === 'guest') { %>

          <a href="/homes"
             class="nav-link <%= currentPage === 'Home' ? 'active' : '' %>">
            <i class="fa-solid fa-compass"></i>
            Explore
          </a>

          <a href="/favourites"
             class="nav-link <%= currentPage === 'favourites' ? 'active' : '' %>">
            <i class="fa-regular fa-heart"></i>
            Favourites
          </a>

          <a href="/bookings"
             class="nav-link <%= currentPage === 'bookings' ? 'active' : '' %>">
            <i class="fa-solid fa-calendar-check"></i>
            My Bookings
          </a>

        <% } %>


        <% if (user && user.userType === 'host') { %>

          <a href="/host/host-home-list"
             class="nav-link <%= currentPage === 'host-homes' ? 'active' : '' %>">
            <i class="fa-solid fa-building"></i>
            My Homes
          </a>

          <a href="/host/add-home"
             class="nav-link <%= currentPage === 'add-home' ? 'active' : '' %>">
            <i class="fa-solid fa-plus"></i>
            Add Home
          </a>

        <% } %>


        <div class="user-menu">

          <span class="avatar">
            <%= user && user.firstName
              ? user.firstName.charAt(0).toUpperCase()
              : 'U' %>
          </span>

          <span class="user-name">
            <%= user && user.firstName
              ? user.firstName
              : 'Account' %>
          </span>

          <!-- LOGOUT -->
          <form action="/logout" method="POST" class="logout-form">
            <button type="submit" class="logout-link">
              Log out
            </button>
          </form>

        </div>

      <% } else { %>

        <!-- LOGGED OUT -->
        <a href="/login"
           class="nav-link <%= currentPage === 'login' ? 'active' : '' %>">
          Log in
        </a>

        <a href="/signup" class="nav-cta">
          Sign up
        </a>

      <% } %>

    </div>


    <!-- MOBILE NAV -->
    <div class="mobile-nav">

      <% if (isLoggedIn) { %>

        <% if (user && user.userType === 'guest') { %>

          <a href="/homes" title="Explore">
            <i class="fa-solid fa-compass"></i>
          </a>

          <a href="/favourites" title="Favourites">
            <i class="fa-regular fa-heart"></i>
          </a>

          <a href="/bookings" title="Bookings">
            <i class="fa-solid fa-calendar-check"></i>
          </a>

        <% } else { %>

          <a href="/host/host-home-list" title="My Homes">
            <i class="fa-solid fa-building"></i>
          </a>

          <a href="/host/add-home" title="Add Home">
            <i class="fa-solid fa-plus"></i>
          </a>

        <% } %>


        <!-- MOBILE LOGOUT -->
        <form action="/logout" method="POST" class="logout-form">
          <button type="submit" title="Log out" class="logout-link">
            <i class="fa-solid fa-right-from-bracket"></i>
          </button>
        </form>


      <% } else { %>

        <!-- LOGGED OUT -->
        <a href="/login">
          Log in
        </a>

        <a href="/signup" class="nav-cta">
          Sign up
        </a>

      <% } %>

    </div>

  </nav>
</header>