<%- include('../partials/head') %>
  </head>
  <body class="app-body">
    <%- include('../partials/nav') %>
    <main class="page-shell">
      <section class="section-heading page-heading">
        <div><span class="eyebrow">Host dashboard</span><h1>Your properties</h1><p>Manage your homes and keep track of reservations.</p></div>
        <a href="/host/add-home" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Add new home</a>
      </section>
      <section class="home-grid">
        <% registeredHomes.forEach(home => { %>
          <article class="home-card host-card">
            <div class="card-image-wrap"><img src="<%= home.photo %>" alt="<%= home.houseName %>"><span class="image-badge"><i class="fa-solid fa-star"></i> <%= home.rating %></span></div>
            <div class="home-card-body">
              <div class="card-title-row"><h3><%= home.houseName %></h3><span class="price">₹<%= home.price %><small> / night</small></span></div>
              <p class="location"><i class="fa-solid fa-location-dot"></i> <%= home.location %></p>
              <% if (bookingsByHome[home._id.toString()]) { %>
                <% const booking = bookingsByHome[home._id.toString()]; %>
                <div class="host-booking booked-box">
                  <span class="status-pill booked"><i class="fa-solid fa-circle"></i> Booked</span>
                  <p><strong><%= booking.user.firstName %> <%= booking.user.lastName %></strong></p>
                  <small><%= booking.user.email %> · <%= new Date(booking.bookingDate).toLocaleDateString() %></small>
                  <form action="/host/bookings/cancel/<%= booking._id %>" method="POST"><button type="submit" class="btn btn-danger-soft btn-sm">Cancel booking</button></form>
                </div>
              <% } else { %>
                <div class="host-booking available-box"><span class="status-pill available"><i class="fa-solid fa-circle"></i> Available</span><small>Ready for a new guest.</small></div>
              <% } %>
              <div class="card-footer">
                <a href="/host/edit-home/<%= home._id %>?editing=true" class="btn btn-outline"><i class="fa-regular fa-pen-to-square"></i> Edit</a>
                <form action="/host/delete-home/<%= home._id %>" method="POST" class="inline-form"><button type="submit" class="btn btn-danger-soft"><i class="fa-regular fa-trash-can"></i> Delete</button></form>
              </div>
            </div>
          </article>
        <% }) %>
      </section>
    </main>
  </body>
</html>