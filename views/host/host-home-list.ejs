<%- include('../partials/head') %>
</head>

<body>
  <%- include('../partials/nav') %>

  <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 max-w-6xl">

    <h2 class="text-3xl text-red-500 font-bold text-center mb-6">
      Hey Host! Here are your homes:
    </h2>

    <div class="flex flex-wrap justify-center gap-6">

      <% registeredHomes.forEach(home => { %>

        <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition duration-300 w-full max-w-sm">

          <!-- Home Image -->
          <img
            src="<%= home.photo %>"
            alt="<%= home.houseName %>"
            class="w-full h-48 object-cover"
          >

          <div class="p-4">

            <!-- Home Name -->
            <h3 class="text-xl font-semibold text-gray-800 mb-2">
              <%= home.houseName %>
            </h3>

            <!-- Location -->
            <p class="text-gray-600 mb-2">
              <i class="fas fa-map-marker-alt mr-2"></i>
              <%= home.location %>
            </p>

            <!-- Price + Rating -->
            <div class="flex justify-between items-center mb-4">

              <span class="text-lg font-bold text-red-500">
                Rs<%= home.price %> / night
              </span>

              <div class="flex items-center">

                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="w-5 h-5 text-yellow-400 mr-1"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l2.082-5.006z"
                    clip-rule="evenodd"
                  />
                </svg>

                <span class="text-gray-700">
                  <%= home.rating %>
                </span>

              </div>
            </div>


            <!-- BOOKING STATUS -->

            <% if (bookingsByHome[home._id.toString()]) { %>

              <% const booking = bookingsByHome[home._id.toString()]; %>

              <!-- Booked -->
              <div class="bg-red-100 border border-red-400 rounded-lg p-4 mb-4">

                <p class="text-red-600 font-bold text-lg mb-2">
                  🔴 Booked
                </p>

                <p class="text-gray-700">
                  <strong>Guest:</strong>
                  <%= booking.user.firstName %>
                  <%= booking.user.lastName %>
                </p>

                <p class="text-gray-700">
                  <strong>Email:</strong>
                  <%= booking.user.email %>
                </p>

                <p class="text-gray-700">
                  <strong>Booking Date:</strong>
                  <%= new Date(booking.bookingDate).toLocaleDateString() %>
                </p>

                <!-- Host Cancel Booking -->
                <form
                  action="/host/bookings/cancel/<%= booking._id %>"
                  method="POST"
                  class="mt-3"
                >

                  <button
                    type="submit"
                    class="bg-red-500 hover:bg-red-700 text-white px-4 py-2 rounded"
                  >
                    Cancel Booking
                  </button>

                </form>

              </div>

            <% } else { %>

              <!-- Available -->
              <div class="bg-green-100 border border-green-400 rounded-lg p-3 mb-4">

                <p class="text-green-600 font-bold">
                  🟢 Available
                </p>

                <p class="text-gray-600 text-sm">
                  This home is currently not booked.
                </p>

              </div>

            <% } %>


            <!-- Edit + Delete Home -->

            <div class="flex gap-2">

              <a
                href="/host/edit-home/<%= home._id %>?editing=true"
                class="bg-blue-500 hover:bg-blue-700 text-white px-4 py-2 rounded"
              >
                Edit
              </a>

              <form
                action="/host/delete-home/<%= home._id %>"
                method="POST"
              >

                <button
                  type="submit"
                  class="bg-red-500 hover:bg-red-700 text-white px-4 py-2 rounded"
                >
                  Delete Home
                </button>

              </form>

            </div>

          </div>
        </div>

      <% }) %>

    </div>
  </main>

</body>
</html>