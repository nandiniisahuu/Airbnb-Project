<%- include('../partials/head') %>
  </head>
  <body class="app-body">
    <%- include('../partials/nav') %>
    <main class="page-shell narrow-shell">
      <div class="form-card">
        <div class="form-header">
          <span class="eyebrow"><%= editing ? 'Update property' : 'New property' %></span>
          <h1><%= editing ? "Edit your home" : "List your home" %></h1>
          <p>Give guests the details they need to fall in love with your place.</p>
        </div>
        <form action="/host/<%= editing ? "edit-home" : "add-home"%>" method="POST" enctype="multipart/form-data" class="modern-form">
          <input type="hidden" name="id" value="<%= editing ? home._id : ''%>" />
          <div class="form-grid">
            <div class="field full"><label for="houseName">Home name</label><div class="input-wrap"><i class="fa-solid fa-house"></i><input type="text" id="houseName" name="houseName" value="<%= editing ? home.houseName : ''%>" placeholder="e.g. The Forest Retreat" required></div></div>
            <div class="field"><label for="price">Price per night</label><div class="input-wrap"><span class="input-prefix">₹</span><input type="text" id="price" name="price" value="<%= editing ? home.price : ''%>" placeholder="4500" required></div></div>
            <div class="field"><label for="rating">Rating</label><div class="input-wrap"><i class="fa-solid fa-star"></i><input type="text" id="rating" name="rating" value="<%= editing ? home.rating : ''%>" placeholder="4.8" required></div></div>
            <div class="field full"><label for="location">Location</label><div class="input-wrap"><i class="fa-solid fa-location-dot"></i><input type="text" id="location" name="location" value="<%= editing ? home.location : ''%>" placeholder="Manali, Himachal Pradesh" required></div></div>
            <div class="field full"><label for="photo">Property photo</label><label class="file-drop"><i class="fa-regular fa-image"></i><span>Choose a JPG, JPEG or PNG image</span><input type="file" id="photo" name="photo" accept="image/jpg, image/jpeg, image/png"></label></div>
            <div class="field full"><label for="description">Description</label><textarea id="description" name="description" placeholder="Describe the space, views, amenities and experience..."><%= editing ? home.description : ''%></textarea></div>
          </div>
          <button type="button" id="generateDescriptionBtn" class="btn btn-ai btn-lg"><i class="fa-solid fa-wand-magic-sparkles"></i> Generate with AI</button>
          <button type="submit" class="btn btn-primary btn-lg full-btn"><%= editing ? "Update home" : "Publish home" %> <i class="fa-solid fa-arrow-right"></i></button>
        </form>
      </div>
    </main>
    <script>
      const generateBtn = document.getElementById("generateDescriptionBtn");
      generateBtn.addEventListener("click", async () => {
        const houseName = document.getElementById("houseName").value.trim();
        const price = document.getElementById("price").value.trim();
        const location = document.getElementById("location").value.trim();
        const rating = document.getElementById("rating").value.trim();
        const description = document.getElementById("description");
        if (!houseName || !price || !location || !rating) { alert("Please fill House Name, Price, Location and Rating first."); return; }
        generateBtn.disabled = true; generateBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Generating...';
        try {
          const response = await fetch("/api/ai/description", { method:"POST", headers:{"Content-Type":"application/json"}, body:JSON.stringify({houseName, price:Number(price.replace(/,/g,"")), location, rating:Number(rating)}) });
          const data = await response.json();
          if (data.success) description.value = data.description; else alert(data.message || "Failed to generate description.");
        } catch (error) { console.error("AI Error:", error); alert("Something went wrong while generating the description."); }
        generateBtn.disabled = false; generateBtn.innerHTML = '<i class="fa-solid fa-wand-magic-sparkles"></i> Generate with AI';
      });
    </script>
  </body>
</html>