<%- include('../partials/head') %>
  </head>
  <body class="auth-body">
    <%- include('../partials/nav') %>
    <main class="auth-shell">
      <div class="auth-card">
        <div class="auth-visual">
          <span class="eyebrow light">Welcome back</span>
          <h2>Make yourself at home.</h2>
          <p>Sign in to explore stays, manage favourites and keep all your trips in one place.</p>
          <div class="auth-quote"><i class="fa-solid fa-quote-left"></i><span>Travel is better when the right place feels like home.</span></div>
        </div>
        <div class="auth-form-side">
          <div class="auth-heading"><span class="mobile-brand">StayNest</span><h1>Welcome back</h1><p>Enter your details to continue.</p></div>
          <form action="/login" method="POST" class="modern-form">
            <%- include('../partials/errors') %>
            <div class="field full"><label for="email">Email address</label><div class="input-wrap"><i class="fa-regular fa-envelope"></i><input type="email" id="email" name="email" placeholder="you@example.com" value="<%= oldInput.email ? oldInput.email : '' %>" required></div></div>
            <div class="field full"><label for="password">Password</label><div class="input-wrap"><i class="fa-solid fa-lock"></i><input type="password" id="password" name="password" placeholder="Enter your password" required></div></div>
            <button type="submit" class="btn btn-primary btn-lg full-btn">Sign in <i class="fa-solid fa-arrow-right"></i></button>
          </form>
          <p class="auth-switch">Don't have an account? <a href="/signup">Create one</a></p>
        </div>
      </div>
    </main>
  </body>
</html>