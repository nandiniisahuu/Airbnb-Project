<%- include('../partials/head') %>
  </head>
  <body class="auth-body">
    <%- include('../partials/nav') %>
    <main class="auth-shell">
      <div class="auth-card signup-card">
        <div class="auth-visual">
          <span class="eyebrow light">Join StayNest</span>
          <h2>Your next adventure starts here.</h2>
          <p>Create an account to discover stays or share your own beautiful home with travellers.</p>
          <div class="benefit-list"><span><i class="fa-solid fa-circle-check"></i> Save favourite stays</span><span><i class="fa-solid fa-circle-check"></i> Manage your bookings</span><span><i class="fa-solid fa-circle-check"></i> Host your own property</span></div>
        </div>
        <div class="auth-form-side">
          <div class="auth-heading"><h1>Create account</h1><p>It only takes a minute to get started.</p></div>
          <form action="/signup" method="POST" class="modern-form">
            <%- include('../partials/errors') %>
            <div class="form-grid">
              <div class="field"><label for="firstName">First name</label><div class="input-wrap"><i class="fa-regular fa-user"></i><input type="text" id="firstName" name="firstName" placeholder="John" value="<%= oldInput.firstName ? oldInput.firstName : '' %>" required></div></div>
              <div class="field"><label for="lastName">Last name</label><div class="input-wrap"><i class="fa-regular fa-user"></i><input type="text" id="lastName" name="lastName" placeholder="Doe" value="<%= oldInput.lastName ? oldInput.lastName : '' %>"></div></div>
              <div class="field full"><label for="email">Email address</label><div class="input-wrap"><i class="fa-regular fa-envelope"></i><input type="email" id="email" name="email" value="<%= oldInput.email ? oldInput.email : '' %>" placeholder="you@example.com" required></div></div>
              <div class="field"><label for="password">Password</label><div class="input-wrap"><i class="fa-solid fa-lock"></i><input type="password" id="password" name="password" placeholder="Create password" required></div></div>
              <div class="field"><label for="confirmPassword">Confirm password</label><div class="input-wrap"><i class="fa-solid fa-lock"></i><input type="password" id="confirmPassword" name="confirmPassword" placeholder="Repeat password" required></div></div>
              <div class="field full"><label>Choose your account type</label><div class="role-options"><label><input type="radio" name="userType" value="guest" id="guest" <%= oldInput.userType === "host" ? "" : "checked" %>><span><i class="fa-solid fa-suitcase-rolling"></i><strong>Guest</strong><small>Find and book stays</small></span></label><label><input type="radio" name="userType" value="host" id="host" <%= oldInput.userType === "host" ? "checked" : "" %>><span><i class="fa-solid fa-building"></i><strong>Host</strong><small>List your property</small></span></label></div></div>
              <div class="field full"><label class="terms"><input type="checkbox" name="terms" id="terms" required><span>I agree to the terms and conditions.</span></label></div>
            </div>
            <button type="submit" class="btn btn-primary btn-lg full-btn">Create account <i class="fa-solid fa-arrow-right"></i></button>
          </form>
          <p class="auth-switch">Already have an account? <a href="/login">Sign in</a></p>
        </div>
      </div>
    </main>
  </body>
</html>